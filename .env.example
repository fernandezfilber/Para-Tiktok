# Generate a long random value, e.g. with: openssl rand -hex 32
APP_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=3001
NODE_ENV=production

# Connect to the existing MySQL container through its published host port.
# URL-encode special characters in the username/password.
DATABASE_URL=mysql://filber_app:URL_ENCODED_PASSWORD@host.docker.internal:3306/filber

# Connect to the existing Redis container through its published host port.
# URL-encode special characters in the password.
REDIS_URL=redis://:URL_ENCODED_PASSWORD@host.docker.internal:6379/0

# Existing Docker network shared by Traefik and the app.
DOCKER_NETWORK=bridge
DOMAIN=filber.tech
TRAEFIK_CERT_RESOLVER=letsencrypt

# Required for AI answers. Keep provider keys in .env only; never commit them.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
TAVILY_API_KEY=

# Required to send WhatsApp verification codes through Meta Cloud API.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=filber_otp
WHATSAPP_TEMPLATE_LANGUAGE=es

# Optional public contact number in international format, e.g. 51999999999.
CONTACT_WHATSAPP=51930860641
